# Crash log files
crash.log
crash.*.log

# Ignore Terraform related files
.terraformrc
terraform.rc
.terraform/

# gemini-cli settings
.gemini/

# GitHub App credentials
gha-creds-*.json

## .tfstate files
*.tfstate
*.tfstate.*
backend.tf

## Exclude all .tfvars files, which are likely to contain sensitive data, such as
## password, private keys, and other secrets. These should not be part of version
## control as they are data points which are potentially sensitive and subject
## to change depending on the environment.
*.tfvars
*.tfvars.json

## Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

## Ignore terraform plan file
tfplan
tfdestroy

## Ignore override files as they are usually used to override resources locally and so
## are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

## tf lock file
.terraform.lock
.terraform.lock.hcl

# Ignore credentials file used in the test setup
credentials.json

# Ignore Python tools files
dist/
.venv/
__pycache__/
.ruff_cache

# Ignore zip files
*.zip
*.tar.gz
.DS_Store

# Node
node_modules/
